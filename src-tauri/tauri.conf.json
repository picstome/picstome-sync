{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Picstome Sync",
  "version": "0.1.27",
  "identifier": "com.picstome.sync",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Picstome Sync",
        "width": 1000,
        "height": 780,
        "minWidth": 820,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/": "resources/"
    },
    "category": "Photography",
    "shortDescription": "Sync Picstome galleries with local photo folders",
    "longDescription": "Picstome Sync keeps Picstome galleries and local photo folders in sync, with the Picstome rating workflow built in.",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "picstome"
        ]
      }
    },
    "updater": {
      "active": false,
      "endpoints": [],
      "dialog": false,
      "pubkey": ""
    }
  }
}
